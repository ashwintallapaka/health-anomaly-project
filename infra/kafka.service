[Unit]
Description=Apache Kafka 4.3.1
After=network.target

[Service]
Type=simple
User=chhayaahuja
Group=chhayaahuja

Environment="JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64"
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

WorkingDirectory=/home/chhayaahuja/kafka

ExecStart=/home/chhayaahuja/kafka/bin/kafka-server-start.sh /home/chhayaahuja/kafka/config/server.properties

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
